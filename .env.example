# ---------- Browser (public, safe to expose; protected by Row Level Security) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------- Server only (Vercel → Settings → Environment Variables; NEVER prefix with VITE_) ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Long random string; also used by Vercel Cron (Authorization: Bearer <CRON_SECRET>) and pg_cron
CRON_SECRET=generate-with-openssl-rand-hex-32
# Public URL of the deployed app (used in e-mail links and invitation redirects)
APP_URL=https://your-app.vercel.app
# E-mail delivery via Resend (https://resend.com). Leave blank to keep e-mails queued.
RESEND_API_KEY=
EMAIL_FROM="Battery Lab Energy <tasks@your-verified-domain.com>"
